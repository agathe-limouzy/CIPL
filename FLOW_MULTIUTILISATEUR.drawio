="1350" width="1270" height="50" as="geometry"/></mxCell><mxCell id="ic-63" value="ReglagePanel → onglets Entreprise, Facturation, Utilisateurs, Abonnement, Documents, Intégrations" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="1445" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-64" value="EntreprisePanel / EntrepriseService → entreprises dont je suis membre (plus de registre PlayerPrefs)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="1445" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-65" value="BatimentManager.SaveBatiment → envoie le bâtiment OU un locataire avec sa version ; SauvegardeDeFermeture supprimé" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1445" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-66" value="PrefabBatLoc.Modify / Save → verrou ; FermetureGuard libère les verrous en quittant" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="1445" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-67" value="Écrans du tableau « écran → verrou » (CONCEPTION §6.3) ; FactureEnvoiAuto → réservation par facture" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1445" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-68" value="PhotoService, BailFileUI, émission des factures, ChargePanel, logo → DocumentsService" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="1605" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-69" value="ReglageService → secrets lus depuis le serveur (admin) ; fin de pennylane_secrets.dat" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="1605" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-70" value="BackupService → devient « Exporter toutes les données » (admin)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1605" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-71" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#B5739D;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="1850" width="1310" height="430" as="geometry"/></mxCell><mxCell id="ic-72" value="SERVEUR (service cloud hébergé en UE) ET STRIPE" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=26;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="1860" width="1270" height="50" as="geometry"/></mxCell><mxCell id="ic-73" value="Comptes : e-mail + mot de passe ; e-mails de confirmation, de mot de passe et d'invitation (liens https://cipl.app/o/… → cipl://)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="1955" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-74" value="Tables : groupes (titulaire, Stripe, offre, licences, statut, fin d'essai, échéance), entreprises (groupe_id), membres (personne × groupe = licence), acces (membre × entreprise)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="1955" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-75" value="Tables métier : batiments, locataires, reglages, secrets, verrous, envois_factures, documents (CONCEPTION §5)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1955" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-76" value="Fonctions serveur : inscription (société : vérifie le SIRET via Pappers ; particulier : sans SIRET), invitation, retrait d'un membre, tâche quotidienne (essais, rappels), export" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="795" y="1955" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-77" value="Stripe : Checkout (paiement), portail client (moyen de paiement, factures), webhooks → statut de l'abonnement" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1045" y="1955" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-78" value="Page relais statique https://cipl.app/o/… : ouvre cipl://… ou propose le téléchargement" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="2115" width="220" height="110" as="geometry"/></mxCell><mxCell id="ic-79" value="Stockage de fichiers : documents par entreprise ; sauvegarde quotidienne" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;spacingRight=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="295" y="2115" width="220" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>